# ------------------------------------------------------------------
# ITFlow instance settings (required)
# ------------------------------------------------------------------

# Base URL of your ITFlow installation (no trailing slash, no /api/v1).
ITFLOW_BASE_URL=https://itflow.example.com

# API key created in ITFlow: Admin Settings > API Keys > Create.
# Scope: "All Clients" or a specific client.
ITFLOW_API_KEY=your-itflow-api-key

# Decryption password shown next to the API key in ITFlow.
# Only needed for the credentials_* tools (encrypted logins).
ITFLOW_API_KEY_PASSWORD=

# ------------------------------------------------------------------
# MCP server settings
# ------------------------------------------------------------------

# API key clients must present to use THIS MCP server
# (required for `serve-http`; stdio does not need it).
# Generate one with: itflow-mcp-server gen-key
# Multiple keys may be listed comma-separated.
MCP_API_KEY=

# Host/port for `serve-http` (default 127.0.0.1:8700).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8700

# Comma-separated Host header allowlist for the HTTP transport.
# DNS-rebinding protection is auto-enabled for loopback hosts; add your
# real hostname here (and the matching origin) when serving publicly.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# ------------------------------------------------------------------
# Tool permissions (which tools the AI can see and call)
# ------------------------------------------------------------------
#
# The tools the AI is given are gated by MCP_TOOL_PERMISSIONS, based on
# what each tool does to an ITFlow object:
#
#   read   - READ-ONLY tools. List/fetch records (clients_read,
#            assets_read, invoices_read, ...). Changes nothing. Safe.
#
#   write  - WRITE tools. Create or modify records (tickets_create,
#            contacts_update, clients_archive, tickets_resolve, ...).
#            Reversible in practice (records can be edited or unarchived),
#            but the AI WILL change your data when it calls them.
#
#   delete - DELETE tools. Permanently remove records (assets_delete,
#            contacts_delete).
#
# !! WARNING !!
# !! Enabling 'delete' lets the AI PERMANENTLY DELETE records in your ITFlow
# !! instance (assets and contacts, including related data such as asset
# !! network interfaces). Deletions cannot be undone. Only enable it if you
# !! actually want the AI to be able to delete things, and consider scoping
# !! the ITFLOW_API_KEY to a single client as a safety net.
#
# Combine levels with commas. Higher levels do NOT imply lower ones - list
# everything you want:
#
#   MCP_TOOL_PERMISSIONS=read                -> AI can only look at data
#   MCP_TOOL_PERMISSIONS=read,write          -> AI can look at AND change data
#   MCP_TOOL_PERMISSIONS=read,write,delete   -> AI has full control (dangerous)
#
# If left empty/unset, the server defaults to read-only.
# Unknown values (typos) make the server refuse to start.
MCP_TOOL_PERMISSIONS=read

# ------------------------------------------------------------------
# Optional tuning
# ------------------------------------------------------------------

# Set to false only for self-signed local test instances (not recommended).
ITFLOW_VERIFY_SSL=true

# HTTP timeout (seconds) for ITFlow API calls.
ITFLOW_TIMEOUT=30

# Extra retry attempts on transient ITFlow failures (5xx/429).
ITFLOW_MAX_RETRIES=2

# Logging: DEBUG, INFO, WARNING, ERROR
MCP_LOG_LEVEL=INFO
