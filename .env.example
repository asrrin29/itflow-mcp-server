# ------------------------------------------------------------------
# ITFlow instance settings (required)
# ------------------------------------------------------------------

# Base URL of your ITFlow installation (no trailing slash, no /api/v1).
ITFLOW_BASE_URL=https://itflow.example.com

# API key created in ITFlow: Admin Settings > API Keys > Create.
# Scope: "All Clients" or a specific client.
ITFLOW_API_KEY=your-itflow-api-key

# Decryption password shown next to the API key in ITFlow.
# Only needed for the credentials_* tools (encrypted logins).
ITFLOW_API_KEY_PASSWORD=

# ------------------------------------------------------------------
# MCP server settings
# ------------------------------------------------------------------

# API key clients must present to use THIS MCP server
# (required for `serve-http`; stdio does not need it).
# Generate one with: itflow-mcp-server gen-key
# Multiple keys may be listed comma-separated.
MCP_API_KEY=

# Host/port for `serve-http` (default 127.0.0.1:8700).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8700

# Comma-separated Host header allowlist for the HTTP transport.
# DNS-rebinding protection is auto-enabled for loopback hosts; add your
# real hostname here (and the matching origin) when serving publicly.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# ------------------------------------------------------------------
# Optional tuning
# ------------------------------------------------------------------

# Set to false only for self-signed local test instances (not recommended).
ITFLOW_VERIFY_SSL=true

# HTTP timeout (seconds) for ITFlow API calls.
ITFLOW_TIMEOUT=30

# Extra retry attempts on transient ITFlow failures (5xx/429).
ITFLOW_MAX_RETRIES=2

# Logging: DEBUG, INFO, WARNING, ERROR
MCP_LOG_LEVEL=INFO
